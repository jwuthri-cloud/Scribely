# =============================================================================
# AssistMe - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit your .env file to version control!


# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="AssistMe"
APP_VERSION="0.1.0"
DESCRIPTION="A FastAPI + Next.js AI agent application with OpenRouter"
ENVIRONMENT=development
DEBUG=true


# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=true
WORKERS=1


# =============================================================================
# Authentication - Clerk
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here
CLERK_JWT_KEY=your-clerk-jwt-verification-key-here
# Optional: JWKS URL for JWT verification. If unset, derived from publishable key.
# CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json


# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistme


# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5


# =============================================================================
# LLM Configuration - OpenRouter
# =============================================================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEFAULT_MODEL=anthropic/claude-4.6-sonnet
MAX_TOKENS=512
TEMPERATURE=0.33


# =============================================================================
# LLM Observability - Langfuse (Optional)
# =============================================================================
# Enable Langfuse for LLM tracing and observability
# Get your keys from: https://cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# For EU region: https://cloud.langfuse.com
# For US region: https://us.cloud.langfuse.com


# =============================================================================
# VECTOR DB
# =============================================================================
# Qdrant / Pinecone / ...
VECTOR_DB_API_KEY=your-qdrant-api-key-here
VECTOR_DB_URL=https://your-cluster-id.region.cloud.qdrant.io
VECTOR_DB_INDEX_NAME=your-index-name
VECTOR_DB_ENVIRONMENT=your-environment


# =============================================================================
# Task Queue - Celery (Optional)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false


# =============================================================================
# File Upload Storage
# =============================================================================
# Directory where meeting recordings and transcripts are stored.
# Relative paths are resolved from the backend/ directory.
# Structure: {UPLOAD_DIR}/{user_id}/{meeting_id}/recording.webm + transcript.json
UPLOAD_DIR=./uploads
# Max sizes (bytes). Defaults: 500MB video, 10MB transcript.
# MAX_VIDEO_SIZE_BYTES=524288000
# MAX_TRANSCRIPT_SIZE_BYTES=10485760


# =============================================================================
# Diarization & Speaker Attribution
# =============================================================================
# Provider: "deepgram" or "assemblyai"
DIARIZATION_PROVIDER=deepgram
DEEPGRAM_API_KEY=your-deepgram-api-key-here
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
# Vision model for speaker identification (OpenRouter model ID, uses OPENROUTER_API_KEY)
# SPEAKER_ID_VISION_MODEL=openai/gpt-5.4
# Number of video frames to extract per speaker (default: 10)
# FRAMES_PER_SPEAKER=10


# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins.
# Include localhost for dev and production domains for deployment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.scribely.xyz,https://scribely.xyz


# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================
ENABLE_METRICS=false
