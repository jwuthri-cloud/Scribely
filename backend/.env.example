# =============================================================================
# AssistMe - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit your .env file to version control!


# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="AssistMe"
APP_VERSION="0.1.0"
DESCRIPTION="Meeting assistant"
ENVIRONMENT=development
DEBUG=true


# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=true
WORKERS=1


# =============================================================================
# Authentication - Clerk
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here
CLERK_JWT_KEY=your-clerk-jwt-verification-key-here
# Optional: JWKS URL for JWT verification. If unset, derived from publishable key.
# CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
#
# Google Calendar: add scope https://www.googleapis.com/auth/calendar.readonly to the
# Google social connection in Clerk. Backend API uses GET .../oauth_access_tokens/{provider};
# Clerk docs use provider "google" (default). Only set if your project differs:
# CLERK_GOOGLE_OAUTH_PROVIDER=google


# =============================================================================
# Web Push (VAPID) — meeting reminders when the browser is closed
# =============================================================================
# Required for /api/v1/push/subscribe and for the background reminder loop. If
# CALENDAR_REMINDER_ENABLED=true but keys are missing, the API logs a warning at startup
# and reminders are not delivered (subscribe returns 503).
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact identifier for the push service (mailto: or https: URL)
VAPID_SUBJECT=mailto:you@example.com
CALENDAR_REMINDER_ENABLED=true
CALENDAR_REMINDER_LEAD_MINUTES=13
CALENDAR_REMINDER_WINDOW_SECONDS=45
# Canonical browser URL for your web app (push links, CORS merge). Production example:
# APP_PUBLIC_BASE_URL=https://www.scribely.xyz
APP_PUBLIC_BASE_URL=http://localhost:3000


# =============================================================================
# Google Calendar (push notifications)
# =============================================================================
# Public HTTPS URL Google calls when calendar changes (POST). Must match your deployed API.
# Example (Railway): https://your-service.up.railway.app/api/v1/calendar/webhook/google
GOOGLE_CALENDAR_WEBHOOK_URL=
# Optional shared secret; must match X-Goog-Channel-Token on watch requests.
GOOGLE_CALENDAR_WEBHOOK_TOKEN=


# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistme


# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
# Set REDIS_ENABLED=true in production (e.g. Railway) so rate limits use Redis.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5


# =============================================================================
# Railway (production)
# =============================================================================
# Create a Railway project with PostgreSQL + Redis plugins and a web service.
# Recommended: set the service Root Directory to backend/ (this folder).
#
# Variables (reference plugin outputs or paste from Railway dashboard):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
#   REDIS_ENABLED=true
#
# Railway sets PORT automatically; the app maps it to the listen port (see config.py).
# Set DEBUG=false, production CORS_ORIGINS, and required secrets (Clerk, OpenRouter,
# Deepgram/AssemblyAI, etc.). For calendar meeting Web Push: set VAPID_PUBLIC_KEY,
# VAPID_PRIVATE_KEY, and APP_PUBLIC_BASE_URL. Uploads under UPLOAD_DIR are ephemeral
# unless you attach a Railway volume or use external object storage.


# =============================================================================
# LLM Configuration - OpenRouter
# =============================================================================
LLM_PROVIDER=openrouter
# Optional WEB CHAT provider (does not affect meeting/rules/embeddings/training/desktop).
CHAT_LLM_PROVIDER=openrouter
# To use ModelGo: set CHAT_LLM_PROVIDER=modelgo and the exact model ID from your account.
MODELGO_API_KEY=
MODELGO_MODEL=
# Optional additional exact IDs for the web chat picker, encoded as a JSON array.
MODELGO_MODELS=[]
# Only enable if all configured ModelGo models accept temperature.
MODELGO_SEND_TEMPERATURE=false
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEFAULT_MODEL=openai/gpt-5.6-terra
MAX_TOKENS=512
TEMPERATURE=0.33


# =============================================================================
# LLM Observability - Langfuse (Optional)
# =============================================================================
# Enable Langfuse for LLM tracing and observability
# Get your keys from: https://cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# For EU region: https://cloud.langfuse.com
# For US region: https://us.cloud.langfuse.com


# =============================================================================
# Vector Database — Pinecone
# =============================================================================
# Single index, multiple namespaces (meeting_transcripts, knowledge, deals, etc.)
# Each namespace contains vectors for all users; user_id metadata filters per-user.
# Get your key from: https://app.pinecone.io
VECTOR_DB_API_KEY=your-pinecone-api-key-here
VECTOR_DB_INDEX_NAME=assistme
# VECTOR_DB_ENVIRONMENT=  # Not required for serverless Pinecone


# =============================================================================
# Web Search
# =============================================================================
# Primary: Tavily — optimized for LLM agents, includes synthesized answers.
# Get your key from: https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Fallback: Google Serper — used automatically if Tavily hits a quota/credit error.
# Get your key from: https://serper.dev
SERPER_API_KEY=your-serper-api-key-here


# =============================================================================
# External Integrations — Composio
# =============================================================================
# Composio provides pre-built OAuth integrations for Gmail, Slack, Google Calendar,
# Notion, HubSpot, Linear, GitHub, Jira, Zapier, and 100+ more apps.
# Users connect their apps via the /api/v1/integrations/connect/{app} endpoint.
# Get your key from: https://app.composio.dev
COMPOSIO_API_KEY=your-composio-api-key-here


# =============================================================================
# Email — Resend (optional, for meeting rules `send_email` steps)
# =============================================================================
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev


# =============================================================================
# Task Queue - Celery (Optional)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false


# =============================================================================
# File Upload Storage
# =============================================================================
# Directory where meeting recordings and transcripts are stored.
# Relative paths are resolved from the backend/ directory.
# Structure: {UPLOAD_DIR}/{user_id}/{meeting_id}/recording.webm + transcript.json
UPLOAD_DIR=./uploads
# Max concurrent meeting post-processing pipelines (semaphore in task_runner). Default 2.
# MEETING_PROCESSING_MAX_CONCURRENT=2
# Re-queue meetings left PENDING/PROCESSING in DB after API restart. Default true.
# MEETING_PROCESSING_RECOVER_ON_STARTUP=true
# Max sizes (bytes). Defaults: 500MB video, 10MB transcript.
# MAX_VIDEO_SIZE_BYTES=524288000
# MAX_TRANSCRIPT_SIZE_BYTES=10485760


# =============================================================================
# Object storage — S3-compatible (MinIO, AWS S3, Cloudflare R2)
# =============================================================================
# When enabled, meeting files are mirrored to the bucket and can be re-downloaded
# if local disk is empty (e.g. after a Railway redeploy). Create a bucket first.
OBJECT_STORAGE_ENABLED=false
# MinIO on Railway: internal URL like http://minio.railway.internal:9000 — use the
# public or private endpoint shown in the MinIO service variables.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=scribely-meetings
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# Required for MinIO and many self-hosted S3 APIs; use false for AWS S3.
S3_USE_PATH_STYLE=true


# =============================================================================
# Diarization & Speaker Attribution
# =============================================================================
# Provider: "deepgram" or "assemblyai"
DIARIZATION_PROVIDER=deepgram
DEEPGRAM_API_KEY=your-deepgram-api-key-here
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
# Vision model for speaker identification (OpenRouter model ID, uses OPENROUTER_API_KEY)
# SPEAKER_ID_VISION_MODEL=openai/gpt-5.6-sol
# Number of video frames to extract per speaker (default: 10)
# FRAMES_PER_SPEAKER=10


# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated browser origins allowed to call this API (Authorization: Bearer …).
# Railway: if you set this, it replaces the code default — include BOTH apex and www if you use them.
# Also set APP_PUBLIC_BASE_URL to your canonical site; the API auto-adds that origin + www/apex peer.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.scribely.xyz,https://scribely.xyz


# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================
ENABLE_METRICS=false

# =============================================================================
# RecallAI API key
# =============================================================================
RECALLAI_API_KEY=4