# Langfuse observability (optional)
# Copy to .env and add your keys from https://cloud.langfuse.com
# When set, all OpenAI chat and summarization calls are traced to Langfuse.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=./certs.p12
CSC_KEY_PASSWORD=

# Clerk desktop auth
# Use the publishable key from your Clerk application.
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Backend API URL for meeting sync and cloud features
BACKEND_API_URL=http://localhost:8000