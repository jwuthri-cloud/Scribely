# Langfuse observability (optional)
# Copy to .env and add your keys from https://cloud.langfuse.com
# When set, all OpenAI chat and summarization calls are traced to Langfuse.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=./certs.p12
CSC_KEY_PASSWORD=