# Langfuse observability (optional)
# Copy to .env and add your keys from https://cloud.langfuse.com
# When set, all OpenAI chat and summarization calls are traced to Langfuse.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── macOS code signing + notarization (required for `npm run dist` Gatekeeper-friendly builds) ──
# Signing: export CSC_LINK and CSC_KEY_PASSWORD (or set here). electron-builder signs the .app.
#
# Notarization: electron-builder runs Apple's notarytool only if credentials are in the environment.
# The `dist` script loads this file via dotenv, so define one of the following sets in `.env`:
#
# Option A — Apple ID + app-specific password (simplest for local builds):
#   1. appleid.apple.com → Sign-In and Security → App-Specific Passwords → generate one.
#   2. Developer account Team ID: developer.apple.com → Membership → Team ID (10 chars).
#   APPLE_ID=you@example.com
#   APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
#   APPLE_TEAM_ID=ABCD123456
#
# Option B — App Store Connect API key (better for CI; recommended by electron-builder):
#   Create a key in App Store Connect → Users and Access → Keys. Download the .p8 file.
#   APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
#   APPLE_API_KEY_ID=XXXXXXXXXX
#   APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Option C — Stored notarytool profile (after `xcrun notarytool store-credentials`):
#   APPLE_KEYCHAIN_PROFILE=your-profile-name
#   # optional: APPLE_KEYCHAIN=path/to.keychain
#
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=./certs.p12
CSC_KEY_PASSWORD=

# Clerk desktop auth
# Use the publishable key from your Clerk application (either name works for the desktop build).
# Release builds embed these at compile time; the installed app does not load .env at runtime.
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Clerk JWT template NAME (not the ID) used at sign-in for a long-lived token.
# In Clerk Dashboard → JWT Templates, create a template and set its Name (e.g. scribely).
# Set Token lifetime = 604800 seconds (7 days). Use CLERK_JWT_TEMPLATE to match that name.
CLERK_JWT_TEMPLATE=scribely

# Backend API URL for meeting sync and cloud features
BACKEND_API_URL=http://localhost:8000

# RecallAI API key — do NOT set in the desktop app. It lives on the backend only
# (backend/.env RECALL_API_KEY); the desktop fetches per-recording upload tokens from
# POST /api/v1/recall/upload-token. Shipping the raw key in the DMG would leak a
# non-expiring, workspace-scoped credential.