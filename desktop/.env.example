# Langfuse observability (optional)
# Copy to .env and add your keys from https://cloud.langfuse.com
# When set, all OpenAI chat and summarization calls are traced to Langfuse.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=./certs.p12
CSC_KEY_PASSWORD=

# Clerk desktop auth
# Use the publishable key from your Clerk application.
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Clerk JWT template NAME (not the ID) used at sign-in for a long-lived token.
# In Clerk Dashboard → JWT Templates, create a template and set its Name (e.g. scribely).
# Set Token lifetime = 604800 seconds (7 days). Use CLERK_JWT_TEMPLATE to match that name.
CLERK_JWT_TEMPLATE=scribely

# Backend API URL for meeting sync and cloud features
BACKEND_API_URL=http://localhost:8000

# Skip NativeHelper (Swift) daemon initialization — useful for CI or non-macOS development
# Set to any non-empty value to skip (e.g. SCRIBELY_SKIP_NATIVE=1)
SCRIBELY_SKIP_NATIVE=

# Log level for the main process (uses consola)
# Values: 0 (fatal) to 5 (trace). Default is info (3).
CONSOLA_LEVEL=