{
  "name": "scribely-desktop",
  "version": "1.0.18",
  "description": "Scribely desktop overlay – invisible to screen sharing",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jwuthri/AssistMe.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "build:native": "./scripts/build-native.sh",
    "build:native:debug": "./scripts/build-native.sh --debug",
    "build:proto": "./scripts/compile-proto.sh",
    "build:icon": "mkdir -p build && magick ../chrome-extension/icons/icon128.png -resize 512x512 build/icon.png",
    "export:question-classifier": "python scripts/export-question-classifier.py",
    "dist": "npm run build:all && electron-builder --mac",
    "build:all": "npm run build:proto && npm run build:native && npm run build",
    "build:extension": "cd .. && ./scripts/pack-extension.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.3.0",
    "@deepgram/sdk": "^4.11.3",
    "@huggingface/transformers": "^3.8.1",
    "@langfuse/openai": "^4.6.1",
    "@langfuse/otel": "^4.6.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "bert-tokenizer": "^1.1.8",
    "compromise": "^14.15.0",
    "consola": "^3.4.2",
    "dotenv": "^17.3.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.5",
    "framer-motion": "^11.15.0",
    "gpt-tokenizer": "^3.4.0",
    "node-machine-id": "^1.1.12",
    "nswindow-napi": "^0.0.3",
    "onnxruntime-node": "^1.24.1",
    "openai": "^6.22.0",
    "protobufjs": "^8.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "smart-whisper": "^0.8.1",
    "ws": "^8.19.0",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.scribely.desktop",
    "productName": "Scribely",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Scribely needs microphone access for meeting transcription and recording.",
        "NSAudioCaptureUsageDescription": "Scribely needs system audio capture for recording meetings with participant audio.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Scribely",
            "CFBundleURLSchemes": [
              "scribely"
            ],
            "CFBundleTypeRole": "Editor"
          }
        ]
      }
    },
    "extraResources": [
      {
        "from": "resources/native/NativeHelper",
        "to": "native/NativeHelper"
      },
      {
        "from": "resources/trayIcon.png",
        "to": "trayIcon.png"
      },
      {
        "from": "resources/trayIcon@2x.png",
        "to": "trayIcon@2x.png"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Jwuthri",
      "repo": "Scribely-Release"
    }
  },
  "overrides": {
    "onnxruntime-node": "$onnxruntime-node"
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.5.8",
    "electron-builder": "^26.7.0",
    "electron-vite": "^3.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
