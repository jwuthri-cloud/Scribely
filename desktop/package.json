{
  "name": "assistme-desktop",
  "version": "0.1.0",
  "description": "AssistMe desktop overlay – invisible to screen sharing",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "build:native": "./scripts/build-native.sh",
    "build:native:debug": "./scripts/build-native.sh --debug",
    "build:proto": "./scripts/compile-proto.sh",
    "dist": "npm run build:all && electron-builder --mac",
    "build:all": "npm run build:proto && npm run build:native && npm run build"
  },
  "dependencies": {
    "@langfuse/openai": "^4.6.1",
    "@langfuse/otel": "^4.6.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@traceloop/node-server-sdk": "^0.22.7",
    "dotenv": "^17.3.1",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.15.0",
    "gpt-tokenizer": "^3.4.0",
    "node-machine-id": "^1.1.12",
    "nswindow-napi": "^0.0.3",
    "onnxruntime-node": "^1.24.1",
    "openai": "^6.22.0",
    "protobufjs": "^8.0.0",
    "smart-whisper": "^0.8.1",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.assistme.desktop",
    "productName": "AssistMe",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "resources/native/NativeHelper",
        "to": "native/NativeHelper"
      }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^3.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
